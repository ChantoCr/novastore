# Application
NODE_ENV=development
CLIENT_PORT=5173
SERVER_PORT=5000

# Frontend
VITE_API_URL=http://localhost:5000/api

# Backend
CORS_ORIGIN=http://localhost:5173
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
BCRYPT_SALT_ROUNDS=12
UPLOAD_DIR=uploads
SERVER_PUBLIC_URL=http://localhost:5000
PRODUCT_IMAGE_MAX_FILE_SIZE_MB=5

# Database connection used by the server
DB_HOST=mysql
DB_PORT=3306
DB_NAME=nova_store
DB_USER=nova_user
DB_PASSWORD=nova_password

# MySQL container bootstrap
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=nova_store
MYSQL_USER=nova_user
MYSQL_PASSWORD=nova_password
